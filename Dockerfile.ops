# Local demo control plane that can start killed MeterMesh node containers.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/ops ./cmd/ops
RUN CGO_ENABLED=0 go build -o /out/ops ./cmd/ops

FROM alpine:3.22
COPY --from=build /out/ops /usr/local/bin/ops
EXPOSE 8090
ENTRYPOINT ["ops"]
